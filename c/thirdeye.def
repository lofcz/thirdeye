LIBRARY thirdeye
EXPORTS
    Thirdeye_CreateContext      @1
    Thirdeye_DestroyContext     @2
    Thirdeye_GetDefaultOptions  @3
    Thirdeye_CaptureToFile      @4
    Thirdeye_CaptureToBuffer    @5
    Thirdeye_FreeBuffer         @6
    Thirdeye_GetLastError       @7
    Thirdeye_GetVersion         @8
    Thirdeye_Prepare            @9
    Thirdeye_Clean              @10
    Thirdeye_State              @11

    ; rundll32 host entry (internal helper process).
    TeSessionEntry              @17
